# Text files keep LF line endings on every platform.
* text=auto eol=lf

# Binary data.
*.ttf binary
*.pdf binary
*.zip binary
*.jpg binary
*.png binary

# The fonts' licences as their makers publish them (CRLF).
assets/fonts/OFL-*.txt -text

# Generated by cargo xtask (keymaps, unicode, terminfo, zones, cacerts):
# folded in diffs and left out of the language statistics.
libs/term/src/layouts.rs linguist-generated
libs/term/src/width_table.rs linguist-generated
userland/coreutils/src/terminfo_caps.rs linguist-generated
rootfs/usr/share/slate/zones linguist-generated
rootfs/etc/ssl/certs/ca-certificates.crt linguist-generated
