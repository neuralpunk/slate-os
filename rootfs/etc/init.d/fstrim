#!/bin/sh
# SPDX-License-Identifier: MIT OR Apache-2.0
# The periodic trim (ADR 0122): once a week, discard the free space of
# every mounted file system whose disk takes discards (`fstrim -a`), so
# SSDs can reuse it. slinit runs and supervises it.
### BEGIN INIT INFO
# Provides:          fstrim
# Required-Start:
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: weekly trim of free disk space
# X-Slate-Exec:      /bin/fstrim --every 7
### END INIT INFO
exit 0
